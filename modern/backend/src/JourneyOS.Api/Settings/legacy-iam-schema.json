 "rule_templates": [
  {
   "id": "seat_blocks_3_24",
   "name": "Limit seat blocks (3 seats, 24 h)",
   "effect": "limit",
   "action_key": "bookings__block_seats",
   "condition": {
    "kind": "always"
   },
   "limits": {
    "max_seats": 3,
    "max_hours": 24
   }
  },
  {
   "id": "cancel_before_2h",
   "name": "No cancelling within 2 h of departure",
   "effect": "deny",
   "action_key": "bookings__cancel_tickets",
   "condition": {
    "kind": "departure_within_hours",
    "hours": 2
   },
   "limits": {}
  },
  {
   "id": "corridor_blocks",
   "name": "Seat blocks only on routes with the person's corridor tag",
   "effect": "deny",
   "action_key": "bookings__block_seats",
   "condition": {
    "kind": "corridor_mismatch"
   },
   "limits": {}
  },
  {
   "id": "read_only",
   "name": "Read-only (view everything, change nothing)",
   "effect": "deny",
   "action_key": "*",
   "condition": {
    "kind": "write_action"
   },
   "limits": {}
  }
 ],
